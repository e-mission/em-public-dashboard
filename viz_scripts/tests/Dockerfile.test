# python 3
ARG SERVER_IMAGE_TAG
FROM shankari/e-mission-server:master_${SERVER_IMAGE_TAG}

VOLUME /plots

ADD environment.yml /
ADD tests/environment.yml /tests/environment.yml

WORKDIR /usr/src/app

RUN /bin/bash -c "source setup/activate.sh && conda env update --name emission --file /environment.yml"
RUN /bin/bash -c "source setup/activate.sh && conda env update --name emission --file /tests/environment.yml"

ADD docker/start_tests.sh /usr/src/app/.docker/start_tests.sh
RUN chmod u+x /usr/src/app/.docker/start_tests.sh

EXPOSE 8888

CMD ["/bin/bash", "/usr/src/app/.docker/start_tests.sh"]
